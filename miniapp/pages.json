{
  "pages": [
    {
      "path": "pages/index/index",
      "style": {
        "navigationBarTitleText": "保温材料商城"
      }
    },
    {
      "path": "pages/category/index",
      "style": {
        "navigationBarTitleText": "产品分类"
      }
    },
    {
      "path": "pages/cart/index",
      "style": {
        "navigationBarTitleText": "询价清单"
      }
    },
    {
      "path": "pages/mine/index",
      "style": {
        "navigationBarTitleText": "我的"
      }
    }
  ],
  "subPackages": [
    {
      "root": "pagesA",
      "pages": [
        {
          "path": "pages/product-detail/index",
          "style": { "navigationBarTitleText": "产品详情" }
        },
        {
          "path": "pages/product-list/index",
          "style": { "navigationBarTitleText": "产品列表" }
        },
        {
          "path": "pages/product-compare/index",
          "style": { "navigationBarTitleText": "产品对比" }
        }
      ]
    },
    {
      "root": "pagesB",
      "pages": [
        {
          "path": "pages/ai-chat/index",
          "style": { "navigationBarTitleText": "AI智能顾问" }
        },
        {
          "path": "pages/smart-recommend/index",
          "style": { "navigationBarTitleText": "智能推荐" }
        },
        {
          "path": "pages/order/index",
          "style": { "navigationBarTitleText": "我的订单" }
        },
        {
          "path": "pages/admin-scan/index",
          "style": { "navigationBarTitleText": "管理后台扫码" }
        }
      ]
    }
  ],
  "preloadRule": {
    "pages/index/index": {
      "network": "all",
      "packages": ["pagesA"]
    }
  },
  "tabBar": {
    "color": "#999999",
    "selectedColor": "#007AFF",
    "borderStyle": "black",
    "backgroundColor": "#ffffff",
    "list": [
      {
        "pagePath": "pages/index/index",
        "iconPath": "static/icons/home.png",
        "selectedIconPath": "static/icons/home-active.png",
        "text": "首页"
      },
      {
        "pagePath": "pages/category/index",
        "iconPath": "static/icons/category.png",
        "selectedIconPath": "static/icons/category-active.png",
        "text": "分类"
      },
      {
        "pagePath": "pages/cart/index",
        "iconPath": "static/icons/cart.png",
        "selectedIconPath": "static/icons/cart-active.png",
        "text": "询价清单"
      },
      {
        "pagePath": "pages/mine/index",
        "iconPath": "static/icons/mine.png",
        "selectedIconPath": "static/icons/mine-active.png",
        "text": "我的"
      }
    ]
  },
  "easycom": {
    "autoscan": true,
    "custom": {
      "^u-(.*)": "uview-ui/components/u-$1/u-$1.vue"
    }
  }
}
