# ===== 数据库 =====
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/insulation_db

# ===== DeepSeek (对话生成) =====
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat

# ===== 通义千问 DashScope (向量嵌入) =====
DASHSCOPE_API_KEY=sk-your-dashscope-api-key
DASHSCOPE_EMBED_MODEL=text-embedding-v3
DASHSCOPE_EMBED_DIMENSIONS=1024

# ===== WeChat =====
WX_APPID=your-miniapp-appid
WX_SECRET=your-miniapp-secret

# ===== JWT =====
JWT_SECRET_KEY=change-to-a-random-string
ADMIN_WECHAT_IDS=["admin-openid-here"]
